+
+/**
+ * 持仓交易流水页（独立功能，路由 /trades/:holdingId）
+ *
+ * 功能：
+ *   - 开启/关闭「交易驱动」：开启后本持仓的数量与平均成本由流水自动推导（有存量自动补开仓基准）
+ *   - 录入/编辑/删除买入卖出交易，FIFO 逐笔法自动核算剩余成本与已实现盈亏
+ *   - 切换回手动模式不会删除任何交易记录
+ */
+export function TradesPage() {
