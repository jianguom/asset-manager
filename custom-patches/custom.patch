+/* ── 自定义导航菜单（src/custom-nav/）── 前缀 cnav-，避免与上游样式冲突 */
+.cnav-gear {
+	display: inline-flex;
+	align-items: center;
+	justify-content: center;
+	width: 28px;
+	height: 28px;
+	padding: 0;
