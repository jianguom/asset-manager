+	font-size: 12px;
+}
+.cnav-badge {
+	flex-shrink: 0;
+	font-size: 11px;
+	padding: 2px 8px;
+	border-radius: 999px;
+	background: var(--surface-2);
+	color: var(--muted);
+}
+.cnav-row-actions {
+	display: flex;
+	gap: 4px;
+	flex-shrink: 0;
+}
+
+.cnav-form {
+	display: flex;
+	flex-direction: column;
+	gap: 8px;
+	padding: 8px 0;
+	border-bottom: 1px solid var(--border);
+}
+.cnav-form-row {
+	display: flex;
+	gap: 8px;
+	align-items: center;
+}
+.cnav-form-row label {
+	flex: 0 0 auto;
+	width: 70px;
+	font-size: 13px;
+	color: var(--muted);
+}
+.cnav-form-row input[type="text"],
+.cnav-form-row input[type="url"],
+.cnav-form-row select {
+	flex: 1;
+	min-width: 0;
+}
+.cnav-form-actions {
+	display: flex;
+	gap: 8px;
+	justify-content: flex-end;
+}
+
+.cnav-empty {
+	color: var(--muted);
+	font-size: 13px;
+	padding: 12px 0;
+	text-align: center;
+}
+
+.cnav-error {
+	color: var(--danger, #dc2626);
+	font-size: 13px;
+	margin: 0;
+}
+.cnav-panel button.danger {
+	color: var(--danger, #dc2626);
+}
+
+.cnav-panel-footer {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 8px;
+	border-top: 1px solid var(--border);
+	padding-top: 12px;
+}
+.cnav-count {
+	color: var(--muted);
+	font-size: 12px;
+}
+
+/* ── 嵌入页（/custom/:id）── */
+.cnav-page {
+	display: flex;
+	flex-direction: column;
+	gap: 8px;
+}
+.cnav-toolbar {
+	display: flex;
+	align-items: center;
+	gap: 8px;
+}
+.cnav-title {
+	font-weight: 600;
+	font-size: 14px;
+	min-width: 0;
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+.cnav-frame {
+	width: 100%;
+}
+.cnav-frame iframe {
+	width: 100%;
+	height: calc(100vh - 150px);
+	min-height: 480px;
+	border: 1px solid var(--border);
+	border-radius: var(--radius);
+	background: #fff;
+	display: block;
+}
diff --git a/src/custom-nav/ui/store.ts b/src/custom-nav/ui/store.ts
new file mode 100644
index 0000000..bb9a19a
--- /dev/null
+++ b/src/custom-nav/ui/store.ts
@@ -0,0 +1,27 @@
+/**
+ * 自定义导航 —— 模块级缓存
+ *
+ * 顶栏（CustomNav）与嵌入页（CustomNavPage）都会读同一份配置，
+ * 用模块级 Promise 缓存避免重复请求；管理面板保存后写入新值。
+ */
+import type { CustomNavItem } from "../types";
+import { navApi } from "./api";
+
+let cached: Promise<CustomNavItem[]> | null = null;
+
+export function getNavItems(force = false): Promise<CustomNavItem[]> {
+	if (!cached || force) {
+		cached = navApi.get().then((res) => res.items).catch((error) => {
+			cached = null;
+			throw error;
+		});
+	}
+	return cached;
+}
+
+/** 保存整表并更新缓存 */
+export async function saveNavItems(items: CustomNavItem[]): Promise<CustomNavItem[]> {
+	const saved = await navApi.put(items).then((res) => res.items);
+	cached = Promise.resolve(saved);
+	return saved;
+}
